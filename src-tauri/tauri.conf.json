{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Amend",
  "version": "0.8.2",
  "identifier": "com.onerlaw.amend",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Amend",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost blob: data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost asset: https://asset.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["bin/node"],
    "resources": ["resources/lsp-servers/**/*"]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/onerlaw/amend/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE0MDYwNkIzQUI5REVFRjYKUldUMjdwMnJzd1lHcEliVTRIOE5TODkvbmJzTjVwRjNuczltVThaZTZ3cERmSUJjclFyTGN4dTYK"
    }
  }
}
